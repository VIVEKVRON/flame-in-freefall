# ==============================================================================
# Flame in Freefall - Monorepo Git Ignore Configuration
# NASA Space Apps Challenge 2026
# ==============================================================================

# Node / Next.js Dependencies & Build Artifacts
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
.vercel/

# Python Virtual Environments & Bytecode
backend/.venv/
.venv/
venv/
ENV/
env/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
playwright-report/
test-results/

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example
backend/.env
!backend/.env.example

# CRITICAL: EXPLICITLY TRACK Pre-computed Vector Store & NASA Technical PDFs
# Render and Vercel builds depend on these committed assets for instant zero-scrape cold start.
!backend/qdrant_data/
!backend/qdrant_data/**
!backend/data/raw/
!backend/data/raw/**
!backend/app/data/

# Qdrant Local Vector DB Single-Process Lock (Do NOT commit runtime lock)
backend/qdrant_data/.lock
backend/qdrant_data/*.lock

# OS & Editor Metadata / Caches
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

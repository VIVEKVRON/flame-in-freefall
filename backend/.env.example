# Gemini API key for structured RAG synthesis (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model identifier (Interactions API)
GEMINI_MODEL=gemini-3.8-flash

# Local disk Qdrant storage directory (swap QDRANT_URL for Docker/Qdrant Cloud later)
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_COLLECTION=nasa_psi_combustion

# Bi-encoder (Stage 1) and Cross-encoder (Stage 2) Hugging Face model IDs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Flask server configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
